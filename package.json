{
  "name": "wallstreet-tieling",
  "version": "0.5.0",
  "description": "Wallstreet Tieling: evidence-first enterprise due diligence, OSINT, risk graph, and desktop-agent investigation runtime",
  "main": "SKILL.md",
  "bin": {
    "wallstreet-tieling": "./bin/cli.js",
    "wst": "./bin/cli.js"
  },
  "files": [
    "SKILL.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "requirements.txt",
    "index.html",
    ".codex-plugin/plugin.json",
    "adapters/*.py",
    "adapters/*.md",
    "adapters/multi_datasource/*.py",
    "adapters/multi_datasource/*.md",
    "adapters/multi_datasource/*.yaml",
    "bin/*.js",
    "bin/*.py",
    "config/api_endpoints.yaml",
    "core/*.py",
    "lib/*.js",
    "api/*.py",
    "tools/codex-mcp-smoke.js",
    "tools/agent-host-smoke.js",
    "tools/run-python.js",
    "tools/run-python.ps1",
    "tools/api-smoke.py",
    "tools/package-privacy-scan.py",
    "tools/local-hygiene-audit.ps1",
    "tools/local-hygiene-clean.ps1",
    "tools/worktree-review-audit.ps1",
    "tools/run-acceptance.ps1",
    "tools/run-focused-tests.ps1",
    "tools/run-terminology-check.ps1",
    "docs/API_CONTRACTS.md",
    "docs/AGENT_HOST_SMOKE_CHECKLIST.md",
    "docs/CLAUDE_CODE_ADAPTER.md",
    "docs/CLAUDE_PROJECT_KNOWLEDGE_PACK.md",
    "docs/CODEX_MARKETPLACE_SUBMISSION_NOTES.md",
    "docs/DATASOURCE_ADMISSION.md",
    "docs/DESKTOP_AGENT_ALPHA_DELIVERY.md",
    "docs/DESKTOP_AGENT_HOSTS.md",
    "docs/HERMES_AGENT_SETUP.md",
    "docs/OFFICE_TASK_MODE_HANDOFF.md",
    "docs/OPEN_AGENT_COMPATIBILITY.md",
    "docs/PLUGIN_MARKET_READINESS.md",
    "docs/REQUIREMENT_INTAKE.md",
    "docs/PROJECT_MAP.md",
    "docs/RELEASE_ASSET_CHECKLIST.md",
    "docs/RELEASE_PORTAL.md",
    "docs/assets/brand-card.svg",
    "deploy/",
    "release/",
    "references/",
    "skills/",
    "sub-skills/"
  ],
  "exports": {
    ".": "./SKILL.md",
    "./cli": "./bin/cli.js",
    "./mcp": "./lib/mcp-server.js",
    "./api": "./api/server.py",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "mcp": "node lib/mcp-server.js",
    "api": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-python.ps1 api/server.py",
    "acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-acceptance.ps1",
    "test:focused": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-focused-tests.ps1",
    "api:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-python.ps1 tools/api-smoke.py",
    "codex:mcp-smoke": "node tools/codex-mcp-smoke.js",
    "agent:host-smoke": "node tools/agent-host-smoke.js",
    "delivery:audit": "node bin/cli.js --delivery-audit",
    "objective:audit": "node bin/cli.js --objective-audit",
    "release:preflight": "node bin/cli.js --release-preflight",
    "release:privacy-scan": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-python.ps1 tools/package-privacy-scan.py --json",
    "hygiene:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-hygiene-audit.ps1",
    "hygiene:audit:json": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-hygiene-audit.ps1 -Json",
    "hygiene:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-hygiene-clean.ps1",
    "hygiene:clean:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-hygiene-clean.ps1 -DryRun",
    "worktrees:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/worktree-review-audit.ps1",
    "worktrees:audit:json": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/worktree-review-audit.ps1 -Json",
    "terminology:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-terminology-check.ps1 -FailOn error",
    "terminology:fix": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-terminology-check.ps1 -FailOn error -Fix",
    "docker:build": "docker build -t dearded/wallstreet-tieling -f deploy/Dockerfile .",
    "docker:run": "docker run -p 8080:8080 dearded/wallstreet-tieling"
  },
  "keywords": [
    "credit-intelligence",
    "due-diligence",
    "financial-analysis",
    "risk-assessment",
    "banking",
    "kyc",
    "kyb",
    "aml",
    "osint",
    "enterprise-investigation",
    "corporate-intelligence",
    "china-banking",
    "loan-review",
    "post-lending",
    "shareholder-penetration",
    "ubo",
    "beneficial-owner",
    "sanctions-screening",
    "people-investigation",
    "ai-skill",
    "agent-skill",
    "prompt-engineering",
    "workbuddy",
    "openclaw",
    "codebuddy",
    "尽调",
    "信贷",
    "风控",
    "反洗钱",
    "财务分析",
    "行业研究",
    "企业调查",
    "股东穿透",
    "clawhub",
    "多智能体",
    "skill"
  ],
  "author": "Dear-Ded",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dear-Ded/wallstreet-tieling"
  },
  "homepage": "https://dear-ded.github.io/wallstreet-tieling/",
  "install": {
    "skills.sh": "npx skills add Dear-Ded/wallstreet-tieling -g -y",
    "clawhub": "clawhub install wallstreet-tieling",
    "openclaw": "openclaw skills install wallstreet-tieling"
  }
}
